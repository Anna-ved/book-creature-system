<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="bookCreaturePU" transaction-type="RESOURCE_LOCAL">

        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <non-jta-data-source>jdbc/BookCreature</non-jta-data-source>

        <class>by.rozze.bookcreaturesystem.entity.BookCreature</class>
        <class>by.rozze.bookcreaturesystem.entity.Coordinates</class>
        <class>by.rozze.bookcreaturesystem.entity.MagicCity</class>
        <class>by.rozze.bookcreaturesystem.entity.Ring</class>

        <shared-cache-mode>NONE</shared-cache-mode>

        <properties>
            <property name="eclipselink.logging.level"
                      value="FINE"/>

            <property name="eclipselink.ddl-generation"
                      value="none"/>

        </properties>

    </persistence-unit>
</persistence>
