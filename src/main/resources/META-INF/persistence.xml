<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="bookCreaturePU" transaction-type="RESOURCE_LOCAL">

        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <class>by.rozze.bookcreaturesystem.entity.BookCreature</class>
        <class>by.rozze.bookcreaturesystem.entity.Coordinates</class>
        <class>by.rozze.bookcreaturesystem.entity.MagicCity</class>
        <class>by.rozze.bookcreaturesystem.entity.Ring</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/book_creatures"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="rozze"/>

            <property name="jakarta.persistence.jdbc.password"
                      value=""/>

            <property name="eclipselink.logging.level"
                      value="FINE"/>

            <property name="eclipselink.ddl-generation"
                      value="create-or-extend-tables"/>

        </properties>

    </persistence-unit>
</persistence>
